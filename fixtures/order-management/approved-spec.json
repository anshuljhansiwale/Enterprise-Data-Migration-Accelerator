    "relationships": [
      {
        "id": "rel-order-lines",
        "from": "order_lines",
        "to": "orders",
        "decision": "embed",
        "why": "q-order-by-id returns lines with the order. Cardinality is a few per order, observed maximum 40, so the array is bounded with maxItems 100.",
        "risks": [
          "A future channel that puts hundreds of lines on one order would pass the bound and push the document toward 16MB. Split lines out under the outlier pattern if that workload appears."
        ]
      },
      {
        "id": "rel-order-customer",
        "from": "customers",
        "to": "orders",
        "decision": "embed",
        "snapshot": true,
        "fields": [
          "customer.customerId",
          "customer.fullName",
          "customer.email"
        ],
        "why": "q-order-by-id needs the customer name and email on the order. The living profile stays in customers because it is updated on its own cadence.",
        "risks": [
          "The source order stores only customer_id, so the snapshot written by this migration is the customer row at migration time, which can differ from the name used at checkout.",
          "Later edits to customers must leave existing order snapshots unchanged. Orders created after cutover snapshot the customer at placement."
        ]
      },
      {
        "id": "rel-addresses",
        "from": "addresses",
        "to": "customers",
        "decision": "reference",
        "why": "Addresses accumulate with no declared upper bound and are edited independently of the customer profile. No access path needs the address book inside the customer document.",
        "risks": [
          "A screen that always renders the customer with every address takes a second read. That access path is not in this workload."
        ]
      },
      {
        "id": "rel-order-ship-address",
        "from": "orders",
        "to": "addresses",
        "decision": "reference",
        "why": "q-order-by-id does not ask for the address body. The order stores shipAddressId.",
        "risks": [
          "The address row can change after the order. The source has no order-time copy of the street text. A later access path that needs the historical ship-to would add a snapshot; this spec does not."
        ]
      },
      {
        "id": "rel-line-product",
        "from": "order_lines",
        "to": "products",
        "decision": "reference",
        "why": "The line already stores product_id, quantity, and unit_price_cents. q-order-by-id does not ask for catalog attributes, so those stay in products.",
        "risks": [
          "Showing the current product name on a past order is a lookup, and the name may have changed since the order."
        ]
      },
      {
        "id": "rel-product-subtypes",
        "from": "products.type",
        "to": "products",
        "decision": "polymorphic",
        "why": "book, electronics, and clothing are variants of one product. q-products-by-type-price filters type and price across the catalog, so one collection with discriminator type matches the shared query.",
        "risks": [
          "Subtype fields are optional on the shared property list so additionalProperties can stay false. A book that also contains brand still validates. The migration writes a subtype field only when the row type owns that field, and omits the field when the source is null.",
          "No access path filters author, brand, or size, so this spec adds no partial index on those fields."
        ]
      }
    ]
  },
  "indexPlan": {
    "workloadProvided": true,
    "indexes": [
      {
        "collection": "orders",
        "keys": {
          "_id": 1
        },
        "name": "_id_",
        "servesQuery": "q-order-by-id",
        "evidence": "stated-query",
        "create": false
      },
      {
        "collection": "products",
        "keys": {
          "type": 1,
          "priceCents": 1
        },
        "name": "type_1_priceCents_1",
        "servesQuery": "q-products-by-type-price",
        "evidence": "stated-query",
        "create": true
      },
      {
        "collection": "orders",
        "keys": {
          "customer.customerId": 1,
          "placedAt": -1
        },
        "name": "customer.customerId_1_placedAt_-1",
        "servesQuery": "q-recent-orders-by-customer",
        "evidence": "stated-query",
        "create": true
      }
    ],
    "notes": "Three access paths were stated and each gets one entry. q-order-by-id is a point read on orders._id, which the default _id_ index already serves, so nothing is created; lines and the customer snapshot are embedded, so it needs no other index. q-products-by-type-price puts the type discriminator first and the price range second, which also returns the results sorted by priceCents ascending, so there is no in-memory sort. It has no partialFilter because the query covers every product type. q-recent-orders-by-customer uses the snapshot path customer.customerId first and then placedAt descending, so it matches the most-recent-first sort. The migration creates two indexes. Evidence is stated-query for all three because no measured slow-query log was supplied. The source UNIQUE key on products.sku was deliberately not promoted because no access path reads by sku. Foreign keys get no index because no access path uses them: orders.shipAddressId, orders.lines.productId, and addresses.customerId. No partial indexes on subtype fields (author, brand, size) were added, since no access path filters on them."
  },
