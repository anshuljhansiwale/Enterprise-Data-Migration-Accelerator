    "accessPaths": [
      {
        "id": "q-order-by-id",
        "statement": "Given an order id, return that order, its lines, and the customer name and email stored with the order.",
        "needs": [
          "order",
          "lines",
          "customer name",
          "customer email"
        ]
      },
      {
        "id": "q-products-by-type-price",
        "statement": "List products of a given type with price below a given amount, sorted by price ascending.",
        "needs": [
          "product type",
          "price",
          "shared product fields"
        ]
      },
      {
        "id": "q-recent-orders-by-customer",
        "statement": "List a customer's orders from most recent to oldest.",
        "needs": [
          "customer id on the order",
          "placed-at timestamp"
        ]
      }
    ]
  },
