    "accessPaths": [
      {
        "id": "q-entry-by-id",
        "statement": "Given a journal entry id, return that entry, its lines, and the account title stored with the entry.",
        "needs": [
          "entry",
          "lines",
          "account title"
        ]
      },
      {
        "id": "q-recent-entries-by-account",
        "statement": "List an account's journal entries from most recent to oldest.",
        "needs": [
          "institution id on the entry",
          "account number on the entry",
          "posted-at timestamp"
        ]
      }
    ]
