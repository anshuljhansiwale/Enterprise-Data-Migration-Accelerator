    "relationships": [
      {
        "id": "rel-journal-lines",
        "from": "journal_lines",
        "to": "journalEntries",
        "decision": "embed",
        "why": "q-entry-by-id returns lines with the entry. Cardinality is about 2 per entry, observed maximum 8, so the array is bounded with maxItems 100.",
        "risks": [
          "An entry that splits across more than 100 lines would fail validation and push the document size up. Split lines out under the outlier pattern if that workload appears."
        ]
      },
      {
        "id": "rel-entry-account",
        "from": "accounts",
        "to": "journalEntries",
        "decision": "embed",
        "snapshot": true,
        "fields": [
          "account.institutionId",
          "account.accountNumber",
          "account.title"
        ],
        "why": "q-entry-by-id needs the account title on the entry, and q-recent-entries-by-account needs the institution id and account number on the entry. The living account stays in accounts.",
        "risks": [
          "The source entry stores only institution_id and account_number, so the title snapshot written by this migration is the account row at migration time, which can differ from the title when the entry was posted.",
          "Later edits to accounts must leave existing entry snapshots unchanged. Entries posted after cutover snapshot the account at posting."
        ]
      },
      {
        "id": "rel-account-signers",
        "from": "account_signers",
        "to": "accounts",
        "decision": "reference",
        "why": "Signer history is retained with no declared upper bound and changes independently of the account title. No access path needs signers with the account.",
        "risks": [
          "A screen that shows an account with its signers takes a second read on accountSigners.accountId. That access path is not in this workload."
        ]
      },
      {
        "id": "rel-account-institution",
        "from": "accounts",
        "to": "institutions",
        "decision": "reference",
        "why": "No access path needs the institution body. The account keeps institutionId inside its compound _id.",
        "risks": []
      }
    ]
  },
  "indexPlan": {
    "workloadProvided": true,
    "indexes": [
      {
        "collection": "journalEntries",
        "keys": {
          "_id": 1
        },
        "name": "_id_",
        "servesQuery": "q-entry-by-id",
        "evidence": "stated-query",
        "create": false
      },
      {
        "collection": "journalEntries",
        "keys": {
          "account.institutionId": 1,
          "account.accountNumber": 1,
          "postedAt": -1
        },
        "name": "account.institutionId_1_account.accountNumber_1_postedAt_-1",
        "servesQuery": "q-recent-entries-by-account",
        "evidence": "stated-query",
        "create": true
      }
    ],
    "notes": "Two access paths were stated and each gets one entry. q-entry-by-id is a point read on journalEntries._id, which the default _id_ index already serves, so nothing is created; lines and the account title snapshot are embedded, so it needs no other index. q-recent-entries-by-account matches both parts of the composite account key on the snapshot paths account.institutionId and account.accountNumber, then sorts by postedAt descending, so the index returns entries most recent first with no in-memory sort. The migration creates one index. Evidence is stated-query for both because no measured slow-query log was supplied. Foreign keys get no index because no access path uses them: accountSigners.accountId and the institution reference inside accounts._id. The accounts composite primary key becomes the compound _id, which the default index already covers, and the source has no UNIQUE constraint to promote. No partial filter is used because neither query restricts to a subset of documents."
  },
