            }
          ],
          "memoRaw": "Monthly service fee reversed after branch review.",
          "memoClassification": {
            "entryCategory": "fee",
            "summary": "Reversal of a monthly service fee after review."
          }
        },
        "validation": {
          "bsonType": "object",
          "required": [
            "_id",
            "account",
            "postedAt",
            "lines"
          ],
          "additionalProperties": false,
          "properties": {
            "_id": {
              "bsonType": "long"
            },
            "account": {
              "bsonType": "object",
              "required": [
                "institutionId",
                "accountNumber",
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "institutionId": {
                  "bsonType": "long"
                },
                "accountNumber": {
                  "bsonType": "string"
                },
                "title": {
                  "bsonType": "string"
                }
              }
            },
            "postedAt": {
              "bsonType": "date"
            },
            "lines": {
              "bsonType": "array",
              "maxItems": 100,
              "items": {
                "bsonType": "object",
                "required": [
                  "lineId",
                  "side",
                  "amountCents"
                ],
                "additionalProperties": false,
                "properties": {
                  "lineId": {
                    "bsonType": "long"
                  },
                  "side": {
                    "enum": [
                      "debit",
                      "credit"
                    ]
                  },
                  "amountCents": {
                    "bsonType": "long"
                  }
                }
              }
            },
            "memoRaw": {
              "bsonType": "string"
            },
            "memoClassification": {
              "bsonType": "object",
              "required": [
                "entryCategory",
                "summary"
              ],
              "additionalProperties": false,
              "properties": {
                "entryCategory": {
                  "enum": [
                    "payment",
                    "transfer",
                    "fee",
                    "interest",
                    "adjustment",
                    "other"
                  ]
                },
                "summary": {
                  "bsonType": "string",
                  "maxLength": 280
                }
              }
            }
          }
        }
      }
