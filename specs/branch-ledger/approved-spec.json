  "documentModel": {
    "collections": [
      {
        "name": "institutions",
        "purpose": "Institution reference data. One document per institutions row, referenced from accounts.",
        "pattern": "reference-target",
        "example": {
          "_id": 12,
          "name": "Sample Institution"
        },
        "validation": {
          "bsonType": "object",
          "required": [
            "_id",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "_id": {
              "bsonType": "long"
            },
            "name": {
              "bsonType": "string"
            }
          }
        }
      },
      {
        "name": "accounts",
        "purpose": "Living account record. One document per accounts row. The composite source key becomes a compound _id.",
        "pattern": "entity",
        "example": {
          "_id": {
            "institutionId": 12,
            "accountNumber": "GB00SAMP00000000000001"
          },
          "title": "Sample Operating Account",
          "currencyCode": "GBP",
          "openedAt": "2021-03-01T00:00:00Z"
        },
        "validation": {
          "bsonType": "object",
          "required": [
            "_id",
            "title",
            "currencyCode",
            "openedAt"
          ],
          "additionalProperties": false,
          "properties": {
            "_id": {
              "bsonType": "object",
              "required": [
                "institutionId",
                "accountNumber"
              ],
              "additionalProperties": false,
              "properties": {
                "institutionId": {
                  "bsonType": "long"
                },
                "accountNumber": {
                  "bsonType": "string"
                }
              }
            },
            "title": {
              "bsonType": "string"
            },
            "currencyCode": {
              "bsonType": "string",
              "minLength": 3,
              "maxLength": 3
            },
            "openedAt": {
              "bsonType": "date"
            }
          }
        }
      },
      {
        "name": "accountSigners",
