              "bsonType": "long"
            },
            "accountId": {
              "bsonType": "object",
              "required": [
                "institutionId",
                "accountNumber"
              ],
              "additionalProperties": false,
              "properties": {
                "institutionId": {
                  "bsonType": "long"
                },
                "accountNumber": {
                  "bsonType": "string"
                }
              }
            },
            "fullName": {
              "bsonType": "string"
            },
            "roleName": {
              "bsonType": "string"
            },
            "isActive": {
              "bsonType": "bool"
            }
          }
        }
      },
      {
        "name": "journalEntries",
        "purpose": "One document per journal_entries row, with embedded lines and an account snapshot.",
        "pattern": "entity",
        "example": {
          "_id": 700001,
          "account": {
            "institutionId": 12,
            "accountNumber": "GB00SAMP00000000000001",
            "title": "Sample Operating Account"
          },
          "postedAt": "2026-10-30T09:15:00Z",
          "lines": [
            {
              "lineId": 1,
              "side": "debit",
              "amountCents": 125000
            },
            {
              "lineId": 2,
              "side": "credit",
